TOKEN=your_token_here
BACKEND_URL=https://your_backend_url_here
# Debe ser idéntica a BOT_API_KEY del backend. Generar con node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BOT_API_KEY=your_bot_api_key_here

# --- Música (yt-dlp) - todas opcionales ---
# Ruta al binario de yt-dlp. Por defecto "yt-dlp" (en Docker ya está en el PATH).
# YTDLP_PATH=yt-dlp
# Runtime JS que usa yt-dlp para los retos de YouTube: node (por defecto), deno o bun.
# YTDLP_JS_RUNTIME=node
# Cliente de YouTube que se prueba primero (más rápido); si falla se usan los por defecto. Vacío = solo los por defecto.
# YTDLP_PLAYER_CLIENT=visionos
# Logs de diagnóstico de música (tiempos de cada paso de .play y retraso del event loop). 1 = activado.
# MUSIC_DEBUG=1
# Fichero de cookies de YouTube (formato Netscape) por si YouTube pide "confirma que no eres un bot".
# YTDLP_COOKIES=/usr/src/app/cookies.txt
